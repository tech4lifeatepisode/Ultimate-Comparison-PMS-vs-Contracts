# Supabase (project jujvtuyksxkoclegjznb)
SUPABASE_URL=https://jujvtuyksxkoclegjznb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Storage (S3-compatible endpoint: https://jujvtuyksxkoclegjznb.storage.supabase.co/storage/v1/s3)
SUPABASE_STORAGE_BUCKET=Contracts

# Optional: override default folder pairs (JSON array)
# BLINDING_FOLDER_PAIRS_JSON=[{"source":"To Fill 1","destination":"Fill 1 Blinded"},{"source":"To Fill 2","destination":"Fill 2 Blinded"},{"source":"Fill 3 NC_1250-NC_1470","destination":"Fill 3 NC_1250-NC_1470 Blinded"}]

# Batch controls
MAX_BLINDING_FILES=10
SKIP_ALREADY_BLINDED=true
STORAGE_DOWNLOAD_RETRIES=4

# Render server (same service as contract extraction)
# AUTO_BLIND_FROM_STORAGE=true
# BLIND_TRIGGER_SECRET=optional-shared-secret
# PORT is set by Render automatically
